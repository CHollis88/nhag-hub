# Supabase (this NEW hub project — a separate Supabase project from the
# existing Young Adults and Choir apps, per the "consolidate to 1 project"
# infra decision, this becomes the single project once Choir migrates in).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the magic-link URL sent in email. Falls back to the
# request's own origin if unset, so this is only required once you're
# behind a custom domain or want links to always point at production.
APP_URL=

# Email provider for magic links. Leave unset (or "none") during
# development — links are logged to the server console instead of sent.
EMAIL_PROVIDER=none

# Required when EMAIL_PROVIDER=resend. Get this from resend.com →
# API Keys. NEVER commit a real key to git — this file is a template only.
RESEND_API_KEY=

# Optional, only matters once a sending domain is verified in Resend.
# Until then, Resend only delivers to the email address your Resend
# account itself is registered under, regardless of what's set here.
# Once verified (Resend dashboard → Domains), set this to an address on
# that domain, e.g. "North Hodge Assembly of God <noreply@mail.nhag.org>".
EMAIL_FROM=

# Push notifications. Generate all three with: npm run generate-vapid
# These are specific to THIS app — don't reuse another app's keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Protects the cron endpoints (daily reading reminder, daily old-content
# cleanup) so only Vercel's own scheduler can trigger them. Any random
# string works — e.g. generate one with: openssl rand -hex 16
CRON_SECRET=

# Lets the app stream a song's linked Drive audio files (voice parts,
# split track, demo) through its own /api/drive-media proxy with a real
# in-app player, instead of falling back to Google's embedded player.
# Get one: console.cloud.google.com → a project → APIs & Services →
# Library → enable "Google Drive API" → Credentials → Create Credentials
# → API key. Restrict it to the Drive API only. Optional — everything
# else in the app works without it, this just controls whether audio
# playback looks native or falls back to Google's own player UI.
GOOGLE_DRIVE_API_KEY=

# ── Bible translations beyond the bundled KJV ────────────────────────
# KJV is local (data/bible/kjv) and needs no key. ESV and NLT come from
# their publishers' own APIs and are cached briefly in Supabase; see
# supabase/migration_032_bible_translations.sql for why that cache is
# deliberately bounded and expiring rather than permanent.
#
# Both publishers allow 5,000 requests/day on their free non-commercial
# tier, counted separately, so the cache is a latency optimization here
# rather than the thing holding the feature up.

# ESV — free non-commercial key from https://api.esv.org/ (Crossway).
# Their terms require the ESV copyright notice and a link to esv.org on
# every page that displays the text; the reader renders both from
# lib/bibleTranslations.js. Don't remove them.
ESV_API_KEY=

# NLT — free key from https://api.nlt.to/Account/Register (Tyndale).
# Without a key, anonymous access is capped at 50 verses/request, which
# is below a long chapter (Psalm 119 is 176), so a key is effectively
# required. With one the cap is 500 verses/request, 5,000/day.
NLT_API_KEY=
